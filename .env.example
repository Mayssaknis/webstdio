# ─────────────────────────────────────────────
# WebStudio — Variables d'environnement
# Copiez ce fichier vers `.env` puis renseignez chaque valeur.
# NE JAMAIS committer le fichier `.env` contenant de vraies valeurs.
# ─────────────────────────────────────────────

# URL publique du site (utilisée pour le SEO, l'origin check du formulaire…)
NEXT_PUBLIC_SITE_URL="https://webstudio.tn"

# Coordonnées affichées sur le site (contact, footer, carte contact)
NEXT_PUBLIC_CONTACT_EMAIL="contact@webstudio.tn"
NEXT_PUBLIC_CONTACT_PHONE="+216 27 272 948"
# Numéro WhatsApp sans espaces ni « + », format international : 216XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER="27 272 948"
NEXT_PUBLIC_CONTACT_ADDRESS="Tunis, Tunisie"

# Réseaux sociaux (facultatifs — laissez vide pour masquer)
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Envoi des demandes par e-mail (Resend)
# Obtenez une clé API sur https://resend.com
RESEND_API_KEY=""
# Adresse qui reçoit les demandes de devis
QUOTE_EMAIL_TO="contact@webstudio.tn"
# Adresse d'expédition (doit être vérifiée dans Resend)
QUOTE_EMAIL_FROM="WebStudio <onboarding@resend.dev>"

# Grain de sel utilisé pour hacher les IP (protection des données personnelles)
PRIVACY_PEPPER="change-me-avec-une-valeur-aleatoire"

# Origines supplémentaires acceptées par l'API (séparées par des virgules) — optionnel
ALLOWED_ORIGINS=""